# Database
DATABASE_URL=sqlite+aiosqlite:///./book_research.db

# Redis for task queue
REDIS_URL=redis://localhost:6379/0

# Tavily API for web search
TAVILY_API_KEY=your_tavily_api_key_here

# Volcengine SearchInfinity Custom API key (not an Ark model API key)
DOUBAO_SEARCH_API_KEY=
DOUBAO_SEARCH_BASE_URL=https://open.feedcoopapi.com

# LLM API (OpenAI compatible)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4-turbo-preview
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# Speech synthesis; leave TTS_API_KEY empty to reuse a SiliconFlow LLM_API_KEY.
TTS_API_KEY=
TTS_BASE_URL=https://api.siliconflow.cn/v1
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B

# Application settings
APP_NAME=Book Podcast Research
APP_VERSION=0.1.0
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Search settings
MAX_SEARCH_RESULTS_PER_QUERY=10
MAX_SEARCH_RETRIES=3
SEARCH_TIMEOUT_SECONDS=30
GOODREADS_PROXY=

# Resource limits
MAX_BOOKS_PER_LIST=100
MAX_CONCURRENT_SEARCHES=5
MAX_TASK_EXECUTION_TIME=600
